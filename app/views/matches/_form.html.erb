<%# app/views/matches/_form.html.erb %>
<%= form_with model: match, local: true, class: "space-y-5" do |f| %>

  <% if match.errors.any? %>
    <div class="bg-red-900 border border-red-700 rounded-lg px-4 py-3 text-sm text-red-200">
      <% match.errors.full_messages.each do |msg| %>
        <p>⚠ <%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :opponent, "Opponent", class: "block text-xs text-gray-400 mb-1" %>
    <%= f.text_field :opponent,
          placeholder: "e.g. The Red Lion",
          class: "w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5
                  text-white text-sm focus:outline-none focus:border-emerald-500" %>
  </div>

  <div>
    <%= f.label :match_date, "Date", class: "block text-xs text-gray-400 mb-1" %>
    <%= f.date_field :match_date,
          class: "w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5
                  text-white text-sm focus:outline-none focus:border-emerald-500" %>
  </div>

  <div>
    <%= f.label :location, "Location", class: "block text-xs text-gray-400 mb-1" %>
    <div class="flex rounded-lg overflow-hidden border border-gray-700">
      <% ["home", "away"].each do |loc| %>
        <label class="flex-1 text-center py-2.5 text-sm cursor-pointer
                       <%= match.location == loc ? 'bg-emerald-700 text-white font-semibold' :
                                                   'bg-gray-800 text-gray-400' %>">
          <%= f.radio_button :location, loc, class: "sr-only" %>
          <%= loc.capitalize %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit match.new_record? ? "Create Match" : "Save Changes",
          class: "flex-1 bg-emerald-700 text-white font-semibold rounded-lg py-3 text-sm cursor-pointer" %>
    <%= link_to "Cancel", matches_path,
          class: "flex-1 bg-gray-800 text-gray-300 font-semibold rounded-lg py-3 text-sm text-center" %>
  </div>

<% end %>
