<%# app/views/matches/show.html.erb — mobile-first Tailwind layout %>

<div class="min-h-screen bg-gray-950 text-white pb-24">

  <%# ── Sticky header ──────────────────────────────────────────── %>
  <header class="bg-gray-900 border-b border-gray-700 px-4 py-4 sticky top-0 z-10">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-lg font-bold text-emerald-400"><%= @match.opponent %></h1>
        <p class="text-xs text-gray-400">
          <%= @match.match_date.strftime("%A, %B %-d") %>
          &bull; <%= @match.location&.capitalize %>
        </p>
      </div>
      <span class="px-2 py-1 rounded text-xs font-semibold
        <%= @match.finalized? ? 'bg-emerald-700 text-emerald-100' :
            @match.completed?  ? 'bg-blue-700 text-blue-100'      :
                                 'bg-yellow-700 text-yellow-100' %>">
        <%= @match.status.capitalize %>
      </span>
    </div>
  </header>

  <div class="px-4 pt-4 space-y-5">

    <%# ── Roster / Absence toggles ──────────────────────────────── %>
    <section>
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
        Roster &amp; Attendance
      </h2>
      <div class="grid grid-cols-2 gap-2">
        <% @players.each do |player| %>
          <% absent     = @absent.include?(player) %>
          <% game_count = @load[player] || 0 %>
          <div class="flex items-center justify-between bg-gray-800 rounded-lg px-3 py-2">
            <div>
              <p class="text-sm font-medium <%= absent ? 'line-through text-gray-500' : '' %>">
                <%= player.name %>
              </p>
              <p class="text-xs <%= absent ? 'text-gray-600' : 'text-emerald-400' %>">
                <%= absent ? "absent" : "#{game_count} game#{'s' if game_count != 1}" %>
              </p>
            </div>

            <% if absent %>
              <% absence = @match.absences.find { |a| a.player_id == player.id } %>
              <%= button_to match_absence_path(@match, absence),
                    method: :delete,
                    class: "text-xs bg-gray-700 text-gray-300 rounded px-2 py-1 shrink-0" do %>
                Mark In
              <% end %>
            <% else %>
              <%= button_to match_absences_path(@match),
                    params: { player_id: player.id },
                    method: :post,
                    class: "text-xs bg-red-900 text-red-300 rounded px-2 py-1 shrink-0" do %>
                Absent
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <%# ── Action buttons ─────────────────────────────────────────── %>
    <div class="flex gap-3">
      <% unless @match.finalized? || @match.completed? %>
        <%= button_to reassign_match_path(@match),
              method: :post,
              class: "flex-1 bg-emerald-700 text-white font-semibold
                      rounded-lg py-3 text-sm text-center" do %>
          🎯 Re-Assign Pairings
        <% end %>

        <%= button_to finalize_match_path(@match),
              method: :post,
              data: { confirm: "Lock in this lineup?" },
              class: "flex-1 bg-blue-700 text-white font-semibold
                      rounded-lg py-3 text-sm text-center" do %>
          🔒 Finalize
        <% end %>
      <% end %>
    </div>

    <%# ── Games list ──────────────────────────────────────────────── %>
    <section>
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
        Games (11 total · 20 player slots)
      </h2>
      <div class="space-y-2">
        <% @games.each do |game| %>
          <div class="bg-gray-800 rounded-xl px-4 py-3">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="text-xs text-gray-400 uppercase tracking-wide">
                  <%= game.format_icon %> Game <%= game.sequence %>
                  &bull; <%= game.display_name %>
                </p>

                <% if game.home_players.any? %>
                  <p class="text-sm font-semibold mt-0.5 truncate">
                    <%= game.home_players.map { |p|
                          "#{p.name}"
                        }.join(" &amp; ").html_safe %>
                  </p>
                <% else %>
                  <p class="text-sm text-yellow-400 mt-0.5">⚠ Unassigned</p>
                <% end %>
              </div>

              <% if game.completed? %>
                <span class="text-xs font-bold bg-blue-800 text-blue-200
                             rounded px-2 py-1 shrink-0">
                  <%= game.home_score %>–<%= game.away_score %>
                </span>
              <% end %>
            </div>

            <%# ── Inline edit form ──────────────────────────────── %>
            <% unless @match.finalized? || @match.completed? %>
              <details class="mt-2">
                <summary class="text-xs text-emerald-400 cursor-pointer select-none">
                  Edit players
                </summary>
                <div class="mt-2 border-t border-gray-700 pt-2">
                  <%= form_with url: match_game_path(@match, game),
                                method: :patch, local: true do |f| %>
                    <p class="text-xs text-gray-400 mb-1">
                      Select exactly <%= game.player_count %> player(s):
                    </p>
                    <div class="grid grid-cols-2 gap-1 mb-2">
                      <% Player.available_for(@match).each do |p| %>
                        <label class="flex items-center gap-2 text-sm">
                          <input type="checkbox"
                                 name="game[player_ids][]"
                                 value="<%= p.id %>"
                                 <%= "checked" if game.home_players.include?(p) %>
                                 class="rounded accent-emerald-500">
                          <%= p.name %>
                          <span class="text-xs text-gray-500">
                            (<%= p.gender_label %>)
                          </span>
                        </label>
                      <% end %>
                    </div>
                    <%= f.submit "Save",
                          class: "w-full bg-emerald-700 text-white rounded
                                  py-2 text-sm font-semibold" %>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

  </div>
</div>
