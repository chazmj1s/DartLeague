<%# app/views/matches/index.html.erb %>
<% content_for :title, "Matches – Darts League" %>

<header class="flex items-center justify-between px-4 py-4 sticky top-0 z-10 bg-gray-950 border-b border-gray-800">
  <h1 class="text-lg font-bold text-emerald-400">🎯 Matches</h1>
  <%= link_to new_match_path,
        class: "text-2xl text-emerald-400 leading-none font-light" do %>＋<% end %>
</header>

<div class="px-4 pt-3 space-y-3">

  <% if @matches.empty? %>
    <div class="text-center text-gray-500 py-16">
      <p class="mb-4">No matches yet.</p>
      <%= link_to "Create your first match", new_match_path,
            class: "bg-emerald-700 text-white px-5 py-2 rounded-lg text-sm font-semibold" %>
    </div>
  <% else %>
    <% @matches.each do |match| %>
      <%= link_to match_path(match), class: "block" do %>
        <div class="bg-gray-800 rounded-xl px-4 py-3 border border-gray-700 active:bg-gray-700">
          <div class="flex items-start justify-between">
            <div>
              <p class="font-semibold text-white"><%= match.opponent %></p>
              <p class="text-xs text-gray-400 mt-0.5">
                <%= match.match_date.strftime("%a, %b %-d") %> · <%= match.location %>
              </p>
            </div>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full
              <%= match.finalized? ? 'bg-emerald-900 text-emerald-300' :
                  match.completed?  ? 'bg-blue-900 text-blue-300'      :
                                      'bg-yellow-900 text-yellow-300' %>">
              <%= match.status.capitalize %>
            </span>
          </div>
          <div class="mt-2 pt-2 border-t border-gray-700">
            <% assigned  = match.games.count { |g| g.status == "assigned" } %>
            <% completed = match.games.count { |g| g.status == "completed" } %>
            <p class="text-xs text-gray-500">
              <%= completed %> completed · <%= assigned %> assigned ·
              <%= 11 - assigned - completed %> pending
            </p>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

</div>
