<%# app/views/players/index.html.erb %>
<% content_for :title, "Roster – Darts League" %>

<header class="flex items-center justify-between px-4 py-4 sticky top-0 z-10 bg-gray-950 border-b border-gray-800">
  <h1 class="text-lg font-bold text-emerald-400">👥 Roster</h1>
  <%= link_to new_player_path, class: "text-2xl text-emerald-400 leading-none font-light" do %>＋<% end %>
</header>

<div class="px-4 pt-3 space-y-4">

  <%# ── Stats row ──────────────────────────────────────────── %>
  <div class="grid grid-cols-4 gap-2">
    <% [
      ["#{@stats[:total]}",  "Players"],
      ["#{@stats[:female]}", "Women"],
      ["#{@stats[:male]}",   "Men"],
      ["#{@stats[:open]}",   "Open"],
    ].each do |val, label| %>
      <div class="bg-gray-800 border border-gray-700 rounded-xl text-center py-3">
        <p class="text-xl font-bold text-emerald-400"><%= val %></p>
        <p class="text-xs text-gray-500 mt-0.5"><%= label %></p>
      </div>
    <% end %>
  </div>

  <% if @stats[:total] < 4 %>
    <div class="bg-yellow-950 border border-yellow-800 rounded-lg px-4 py-2 text-sm text-yellow-300">
      ⚠ Need at least 4 players to run a match.
    </div>
  <% end %>

  <% if @stats[:female] == 0 %>
    <div class="bg-yellow-950 border border-yellow-800 rounded-lg px-4 py-2 text-sm text-yellow-300">
      ⚠ At least one female player is required per league rules.
    </div>
  <% end %>

  <%# ── Player list ─────────────────────────────────────────── %>
  <% if @players.empty? %>
    <p class="text-center text-gray-500 py-12">No players yet.</p>
  <% else %>
    <div class="space-y-2">
      <% @players.each do |player| %>
        <div class="bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <p class="font-medium"><%= player.name %></p>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full
              <%= player.female? ? 'bg-purple-950 text-purple-300' : 'bg-blue-950 text-blue-300' %>">
              <%= player.gender_label %>
            </span>
          </div>
          <div class="flex items-center gap-2">
            <%= link_to edit_player_path(player),
                  class: "text-xs text-gray-400 bg-gray-700 rounded px-2 py-1" do %>✏<% end %>
            <%= button_to player_path(player),
                  method: :delete,
                  data: { turbo_confirm: "Remove #{player.name} from the roster?" },
                  class: "text-xs text-red-400 bg-red-950 rounded px-2 py-1" do %>✕<% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
